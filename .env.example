# Milesight gateway connection
MILESIGHT_HOST=192.168.1.1
MILESIGHT_PORT=8080
MILESIGHT_USER=admin
MILESIGHT_PASSWORD=changeme

# Default organizationID used when a tool call omits one
MILESIGHT_ORG_ID=1

# Set to "true" only if the gateway presents a trusted certificate.
# Leave unset/false for the default self-signed cert.
MILESIGHT_VERIFY_TLS=false
